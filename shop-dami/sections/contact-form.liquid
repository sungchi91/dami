{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .contact__intro {
    margin-bottom: 2rem;
    line-height: 1.7;
    color: currentColor;
    font-size: 18px !important;
  }

  .contact__date-row {
    display: flex;
    gap: 0.75rem;
  }

  .contact__date-row .field {
    flex: 1;
  }

  .contact__date-row .field:last-child {
    flex: 2;
  }

  .contact__date-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 1.6rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">

    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}

    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}

        <p class="contact__intro">
          Interested in placing a special order? Fill out the form below and we'll follow up with pricing, available options, and a production timeline. Please note that bulk orders require additional processing time beyond our standard turnaround.
        </p>

        <div class="field">
          <input
            class="field__input"
            autocomplete="given-name"
            type="text"
            id="ContactForm-name"
            name="contact[First Name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            placeholder="First name"
          >
          <label class="field__label" for="ContactForm-name">First name</label>
        </div>

        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="Email"
          >
          <label class="field__label" for="ContactForm-email">
            Email <span aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>

        <div style="display:flex; flex-direction:column; margin-bottom: 2rem;">
          <label for="ContactForm-product" style="display:block; font-size:1.6rem; margin-bottom:0.5rem;">Product</label>
          <select
            id="ContactForm-product"
            name="contact[Product]"
            style="width:100%; padding: 1.5rem; border: 0.1rem solid rgba(var(--color-foreground), 0.55); border-radius: var(--inputs-radius); background: transparent; font-size: 1.4rem; color: rgba(var(--color-foreground), 0.75);"
          >
            <option value=""></option>
            <option value="Grand Tote">Grand Tote</option>
            <option value="Signature Tote">Signature Tote</option>
            <option value="Petite Tote">Petite Tote</option>
            <option value="Petite Crossbody">Petite Crossbody</option>
            <option value="Grand Waffle Pouch">Grand Waffle Pouch</option>
            <option value="Waffle Pouch">Waffle Pouch</option>
            <option value="Seersucker Pouch">Seersucker Pouch</option>
            <option value="Linen Cocktail Napkin">Linen Cocktail Napkin</option>
            <option value="The Oxford">The Oxford</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="field">
          <input
            type="text"
            id="ContactForm-color"
            class="field__input"
            name="contact[Color]"
            placeholder="Color"
          >
          <label class="field__label" for="ContactForm-color">Color</label>
        </div>

        <div class="field">
          <input
            type="number"
            id="ContactForm-quantity"
            class="field__input"
            name="contact[Quantity]"
            min="1"
            placeholder="How Many?"
          >
          <label class="field__label" for="ContactForm-quantity">How Many?</label>
        </div>

        <div>
          <span class="contact__date-label">When is your event?</span>
          <div class="contact__date-row">
            <div class="field">
              <input
                type="text"
                id="ContactForm-month"
                class="field__input"
                name="contact[Event Month]"
                placeholder="MM"
                maxlength="2"
                inputmode="numeric"
              >
              <label class="field__label" for="ContactForm-month">MM</label>
            </div>
            <div class="field">
              <input
                type="text"
                id="ContactForm-day"
                class="field__input"
                name="contact[Event Day]"
                placeholder="DD"
                maxlength="2"
                inputmode="numeric"
              >
              <label class="field__label" for="ContactForm-day">DD</label>
            </div>
            <div class="field">
              <input
                type="text"
                id="ContactForm-year"
                class="field__input"
                name="contact[Event Year]"
                placeholder="YYYY"
                maxlength="4"
                inputmode="numeric"
              >
              <label class="field__label" for="ContactForm-year">YYYY</label>
            </div>
          </div>
        </div>

        <div class="field">
          <textarea
            rows="6"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            placeholder="Any questions?"
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="ContactForm-body">Any questions?</label>
        </div>

        <div class="contact__button">
          <button type="submit" class="button">
            {{ 'templates.contact.form.send' | t }}
          </button>
        </div>

      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
