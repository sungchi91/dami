<style>
  .el {
    --el-navy:     #1B3054;
    --el-ink:      #2f2f2f;
    --el-cream:    #f7f4ef;
    --el-tan:      #e8e0d5;
    --el-white:    #ffffff;
    --el-taupe:    #d9d0bc;
    --el-red:      #781E23;
    --el-muted:    #6b6358;
    color: var(--el-ink);
    -webkit-font-smoothing: antialiased;
  }

  .el * { box-sizing: border-box; }

  .el-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .el-eyebrow {
    display: block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--el-muted);
    margin-bottom: 12px;
    font-family: var(--font-body-family);
  }

  /* HERO */
  .el-hero {
    background: var(--el-white);
    padding: 80px 80px 72px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .el-hero h1 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 60px);
    color: var(--el-ink);
    line-height: 1.1;
    margin: 0 auto 20px;
    max-width: 700px;
  }
  .el-hero h1 em { font-style: italic; }
  .el-hero .el-lede {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: var(--el-muted);
    max-width: 480px;
    margin: 0 auto 32px;
    line-height: 1.65;
  }
  .el-btn-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .el-btn {
    display: inline-block;
    padding: 11px 26px;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #7a9bad;
    color: #7a9bad;
    background: transparent;
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }
  .el-btn:hover { background: #7a9bad; color: #fff; border-color: #7a9bad; }
  .el-btn--filled { background: #7a9bad; color: #fff; border-color: #7a9bad; }
  .el-btn--filled:hover { background: #6a8a9a; border-color: #6a8a9a; }

  /* HOW IT WORKS */
  .el-how {
    background: var(--el-cream);
    padding: 80px 0;
  }
  .el-how-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .el-how-copy h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 44px);
    color: var(--el-ink);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .el-how-copy p {
    font-family: var(--font-body-family);
    font-size: 14.5px;
    color: var(--el-muted);
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .el-steps { display: flex; flex-direction: column; gap: 24px; margin-top: 8px; }
  .el-step { display: flex; gap: 20px; align-items: flex-start; }
  .el-step-num {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 13px;
    color: var(--el-muted);
    min-width: 24px;
    padding-top: 3px;
    letter-spacing: 0.05em;
  }
  .el-step h4 {
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 600;
    color: var(--el-ink);
    margin: 0 0 4px;
  }
  .el-step p { font-family: var(--font-body-family); color: var(--el-muted); font-size: 14.5px; margin: 0; line-height: 1.6; }

  /* EVENTS */
  .el-events {
    background: var(--el-white);
    padding: 80px 0;
  }
  .el-events-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .el-section-label {
    margin-bottom: 48px;
  }
  .el-section-label h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    color: var(--el-ink);
    line-height: 1.2;
    margin: 0 0 10px;
  }
  .el-section-label p {
    font-family: var(--font-body-family);
    font-size: 14.5px;
    color: var(--el-muted);
    margin: 0;
    line-height: 1.6;
  }
  .el-events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .el-event-card {
    background: var(--el-white);
    border: 1px solid var(--el-taupe);
    padding: 32px 28px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .el-event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(27,48,84,0.08);
  }
  .el-event-icon {
    width: 28px; height: 28px;
    color: var(--el-muted);
    margin-bottom: 16px;
    display: block;
  }
  .el-event-card h4 {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 600;
    color: var(--el-ink);
    margin: 0 0 8px;
  }
  .el-event-card p { font-family: var(--font-body-family); font-size: 14px; color: var(--el-muted); margin: 0; line-height: 1.65; }

  /* WHY */
  .el-why {
    background: var(--el-tan);
    padding: 80px 0;
  }
  .el-why-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .el-why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    margin-top: 48px;
  }
  .el-why-item h4 {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 22px;
    color: var(--el-ink);
    margin: 0 0 10px;
  }
  .el-why-item p { font-family: var(--font-body-family); font-size: 14.5px; color: var(--el-muted); margin: 0; line-height: 1.65; }

  /* FAQ */
  .el-faq {
    background: var(--el-cream);
    padding: 80px 0;
  }
  .el-faq-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    align-items: start;
  }
  .el-faq-list { border-top: 1px solid var(--el-taupe); }
  .el-faq-item { border-bottom: 1px solid var(--el-taupe); }
  .el-faq-btn {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 20px 0;
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 600;
    color: var(--el-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .el-faq-plus {
    font-size: 18px;
    color: var(--el-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
    line-height: 1;
    font-family: var(--font-body-family);
  }
  .el-faq-item.el-open .el-faq-plus { transform: rotate(45deg); }
  .el-faq-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .el-faq-text { padding: 0 24px 20px 0; color: var(--el-muted); font-size: 15px; font-family: var(--font-body-family); line-height: 1.7; }

  /* INQUIRY */
  .el-inquiry {
    background: var(--el-navy);
    padding: 80px 0;
  }
  .el-inquiry-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: start;
  }
  .el-inquiry-copy h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 48px);
    color: var(--el-cream);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .el-inquiry-copy h2 em { font-style: italic; }
  .el-inquiry-copy p { font-family: var(--font-body-family); font-size: 14px; color: rgba(247,244,239,0.65); margin: 0 0 12px; line-height: 1.7; }
  .el-inquiry-tagline { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(247,244,239,0.35); margin-top: 32px; font-family: var(--font-body-family); }

  .el-field { margin-bottom: 18px; }
  .el-field label {
    display: block;
    font-family: var(--font-body-family);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247,244,239,0.85);
    margin-bottom: 7px;
  }
  .el-field input,
  .el-field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid rgba(247,244,239,0.2);
    background: rgba(247,244,239,0.06);
    font-family: var(--font-body-family);
    font-size: 14px;
    color: var(--el-cream);
    transition: border-color 0.2s;
    border-radius: 0;
    appearance: none;
  }
  .el-field input::placeholder,
  .el-field textarea::placeholder { color: rgba(247,244,239,0.3); }
  .el-field input:focus,
  .el-field textarea:focus { outline: none; border-color: rgba(247,244,239,0.5); }
  .el-field textarea { resize: vertical; min-height: 100px; }
  .el-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .el-submit-btn {
    background: var(--el-cream);
    color: var(--el-navy);
    border: none;
    padding: 12px 32px;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 4px;
  }
  .el-submit-btn:hover { opacity: 0.85; }
  .el-form-success { color: var(--el-cream); padding: 32px 0; }
  .el-form-success h3 { font-family: var(--font-heading-family); font-size: 26px; font-weight: 400; margin: 0 0 10px; color: var(--el-cream); }
  .el-form-success p { font-size: 14px; color: rgba(247,244,239,0.65); margin: 0; }

  /* Responsive */
  @media (max-width: 900px) {
    .el-how-inner, .el-faq-inner, .el-inquiry-inner { grid-template-columns: 1fr; gap: 48px; }
    .el-why-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
    .el-events-grid { grid-template-columns: 1fr 1fr; }
    .el-form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .el-wrap, .el-hero, .el-how-inner, .el-events-inner, .el-why-inner, .el-faq-inner, .el-inquiry-inner { padding-left: 24px; padding-right: 24px; }
    .el-events-grid { grid-template-columns: 1fr; }
    .el-why-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="el">

  <!-- HERO -->
  <div class="el-hero">
    <span class="el-eyebrow">Live Embroidery Events</span>
    <h1>The Live Embroidery Experience People Keep <em>Talking About</em></h1>
    <p class="el-lede">We bring our embroidery studio to your event — stitching personalized keepsakes on the spot, live and in person.</p>
    <div class="el-btn-row">
      <a href="#el-inquire" class="el-btn el-btn--filled">Request a Quote</a>
      <a href="#el-how" class="el-btn">See How It Works</a>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <div id="el-how" class="el-how">
    <div class="el-how-inner">
      <div class="el-how-copy">
        <span class="el-eyebrow">The Experience</span>
        <h2>A keepsake, made while they watch.</h2>
        <p>Guests choose an item, pick their initials, name or icon, choose a font style and thread color, and watch it get stitched in just a few minutes. They walk away with something made for them, on the spot. No catalogs, no waiting weeks.</p>
        <p>It's the same hand-finished quality you'd find in our shop, just brought to life in front of an audience.</p>
      </div>
      <div>
        <div class="el-steps">
          <div class="el-step">
            <span class="el-step-num">01</span>
            <div><h4>Choose an item</h4><p>Choose from a curated selection of items.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">02</span>
            <div><h4>Pick a font style and thread color</h4><p>From our house scripts and color library.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">03</span>
            <div><h4>Watch it stitched</h4><p>Most pieces take just a few minutes, start to finish.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">04</span>
            <div><h4>Take it home</h4><p>Wrapped and ready, with their name already on it.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- EVENT TYPES -->
  <div id="el-events" class="el-events">
    <div class="el-events-inner">
      <div class="el-section-label">
        <span class="el-eyebrow">Where We Show Up</span>
        <h2>Events we're booked for</h2>
        <p>If people are gathering, there's likely a reason to stitch something for them.</p>
      </div>
      <div class="el-events-grid">
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M16 27s-10-6.2-10-13.4C6 9.8 8.9 7 12.4 7c1.8 0 3.4.9 4.4 2.3.9-1.4 2.5-2.3 4.3-2.3C24.7 7 27 9.8 27 13.6 27 20.8 16 27 16 27z"/></svg>
          <h4>Weddings &amp; Bridal Showers</h4>
          <p>Monogrammed favors for bridal showers, welcome bags, and reception send-offs guests hold onto for years.</p>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="13" width="22" height="14" rx="1"/><path d="M11 13V9a5 5 0 0 1 10 0v4"/></svg>
          <h4>Corporate &amp; Team Events</h4>
          <p>Onboarding days, milestones, and client appreciation events — swag people actually want.</p>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M16 5v22M9 9l14 14M23 9 9 23"/><circle cx="16" cy="16" r="11"/></svg>
          <h4>Brand Activations &amp; Pop-Ups</h4>
          <p>A hands-on moment at your retail event or market that draws a crowd and lingers in their feed.</p>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M16 6v3M9 13l14 0M7 13l2 14h14l2-14M11 13a5 5 0 0 1 10 0"/></svg>
          <h4>Birthdays &amp; Private Parties</h4>
          <p>A personalized favor station guests remember more than the cake table.</p>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M16 4v24M8 12l8 4 8-4M8 20l8 4 8-4"/></svg>
          <h4>Holiday Gatherings</h4>
          <p>Stockings, ornaments, and gift totes — stitched fresh at your seasonal party.</p>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="4"/><circle cx="21" cy="11" r="4"/><path d="M5 26c0-4 2.5-7 6-7s6 3 6 7M15 26c0-4 2.5-7 6-7s6 3 6 7"/></svg>
          <h4>Baby Showers &amp; Milestones</h4>
          <p>Welcome gifts and milestone keepsakes guests can personalize before they go.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- WHY US -->
  <div id="el-why" class="el-why">
    <div class="el-why-inner">
      <div class="el-section-label">
        <span class="el-eyebrow">The Difference</span>
        <h2>Why hosts book us</h2>
      </div>
      <div class="el-why-grid">
        <div class="el-why-item">
          <h4>A real keepsake</h4>
          <p>Not a vendor table — a working studio, run by the same two hands behind every Ember Lane order.</p>
        </div>
        <div class="el-why-item">
          <h4>A moment worth posting</h4>
          <p>Guests pull out their phones before the needle even stops. It's the part of your event people remember.</p>
        </div>
        <div class="el-why-item">
          <h4>Your colors, your fonts</h4>
          <p>Our thread library and house scripts flex to fit your event's palette — or your brand's.</p>
        </div>
        <div class="el-why-item">
          <h4>Minutes, not weeks</h4>
          <p>No pre-orders, no waiting. Guests choose, watch, and walk away with it the same day.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div id="el-faq" class="el-faq">
    <div class="el-faq-inner">
      <div>
        <span class="el-eyebrow">Good to Know</span>
        <h2 style="font-family:var(--font-heading-family);font-weight:400;font-size:clamp(26px,3vw,38px);color:var(--el-ink);line-height:1.2;margin:0;">Frequently asked questions</h2>
      </div>
      <div class="el-faq-list">
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How far in advance should I book?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">We recommend reaching out at least 4–6 weeks ahead, especially for spring, fall, and the holiday season — those dates fill fastest.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">Do you travel for events?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Yes — we're based in the San Francisco Bay Area and travel up to 2–3 hours for events. Travel fees may apply depending on distance, and we'll outline those clearly in your quote.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">What items can guests personalize?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">We can curate and source a selection of items for your event, or you're welcome to provide the goods yourself. Tell us what you have in mind and we'll let you know what works.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How much space and power do you need?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">A single station needs roughly a 7' × 7' footprint and access to a standard electrical outlet. Let us know your venue layout and we'll help plan around it.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How long does one piece take to stitch?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Most pieces are finished in three to eight minutes, depending on size and design complexity.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">Can you match our event or brand colors?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Absolutely. We carry a wide library of thread colors and can style the station to fit your palette. For brand events, we can also digitize a logo to stitch.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How much does it cost?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Pricing depends on event length, guest count, and items selected. Share your event details below and we'll follow up with a clear, custom quote — no surprises.</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- INQUIRY -->
  <div id="el-inquire" class="el-inquiry">
    <div class="el-inquiry-inner">
      <div class="el-inquiry-copy">
        <span class="el-eyebrow" style="color:rgba(247,244,239,0.4)">Book the Experience</span>
        <h2>Let's Make<br><em>it Happen</em></h2>
        <p>Ready to bring live embroidery to your event? Fill out the details and we'll follow up with availability and a custom quote.</p>
        <div class="el-inquiry-tagline">Ember Lane &middot; California, made by hand</div>
      </div>
      <div>
        {%- form 'contact', id: 'el-inquiry-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="el-form-success">
              <h3>Thank you.</h3>
              <p>We've received your inquiry and will follow up within 1–2 business days with availability and a custom quote.</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p style="color:rgba(247,100,100,0.9);font-size:14px;margin:0 0 16px;">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="el-form-row">
              <div class="el-field">
                <label for="el-firstName">First Name</label>
                <input type="text" id="el-firstName" name="contact[first_name]" required autocomplete="given-name">
              </div>
              <div class="el-field">
                <label for="el-lastName">Last Name</label>
                <input type="text" id="el-lastName" name="contact[last_name]" required autocomplete="family-name">
              </div>
            </div>
            <div class="el-field">
              <label for="el-email">Email</label>
              <input type="email" id="el-email" name="contact[email]" required autocomplete="email">
            </div>
            <div class="el-field">
              <label for="el-phone">Phone</label>
              <input type="tel" id="el-phone" name="contact[phone]" required autocomplete="tel">
            </div>
            <div class="el-form-row">
              <div class="el-field">
                <label for="el-eventDate">Event Date</label>
                <input type="date" id="el-eventDate" name="contact[event_date]" required>
              </div>
              <div class="el-field">
                <label for="el-guestCount">Estimated Guests</label>
                <input type="number" id="el-guestCount" name="contact[guest_count]" min="1" required>
              </div>
            </div>
            <div class="el-field">
              <label for="el-eventAddress">Event Address</label>
              <input type="text" id="el-eventAddress" name="contact[event_address]" required autocomplete="street-address">
            </div>
            <div class="el-field">
              <label for="el-details">Tell us about your event</label>
              <textarea id="el-details" name="contact[body]" required placeholder="What do you have in mind?"></textarea>
            </div>
            <button type="submit" class="el-submit-btn">Submit Inquiry</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  document.querySelectorAll('.el-faq-item').forEach(function (item) {
    var btn  = item.querySelector('.el-faq-btn');
    var body = item.querySelector('.el-faq-body');
    btn.addEventListener('click', function () {
      var isOpen = item.classList.contains('el-open');
      document.querySelectorAll('.el-faq-item.el-open').forEach(function (o) {
        o.classList.remove('el-open');
        o.querySelector('.el-faq-btn').setAttribute('aria-expanded', 'false');
        o.querySelector('.el-faq-body').style.maxHeight = null;
      });
      if (!isOpen) {
        item.classList.add('el-open');
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

})();
</script>

{% schema %}
{
  "name": "Live Events Page",
  "tag": "section",
  "class": "section"
}
{% endschema %}
