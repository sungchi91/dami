<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .el {
    --el-sans: 'Work Sans', 'Helvetica Neue', Arial, sans-serif;
    font-family: var(--el-sans);
    --el-navy:     #1B3054;
    --el-ink:      #2f2f2f;
    --el-cream:    #f7f4ef;
    --el-tan:      #e8e0d5;
    --el-white:    #ffffff;
    --el-taupe:    #d9d0bc;
    --el-red:      #781E23;
    --el-muted:    #6b6358;
    color: var(--el-ink);
    -webkit-font-smoothing: antialiased;
  }

  .el * { box-sizing: border-box; }

  .el-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .el-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--el-muted);
    margin-bottom: 12px;
    font-family: var(--el-sans);
  }

  /* HERO */
  .el-hero {
    position: relative;
    background-image: linear-gradient(rgba(40,40,40,0.6), rgba(40,40,40,0.72)), url({{ 'live-events-hero.jpg' | asset_url }});
    background-size: cover;
    background-position: center 65%;
    padding: 120px 80px;
    text-align: center;
    isolation: isolate;
  }
  .el-hero h1 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 60px);
    color: var(--el-white);
    line-height: 1.1;
    margin: 0 auto 20px;
    max-width: 700px;
  }
  .el-hero h1 em { font-style: italic; }
  .el-hero .el-eyebrow { color: rgba(255,255,255,0.75); }
  .el-hero .el-lede {
    font-family: var(--el-sans);
    font-size: 16px;
    color: rgba(247,244,239,0.85);
    max-width: 480px;
    margin: 0 auto 32px;
    line-height: 1.65;
  }
  .el-hero .el-service-area { color: rgba(247,244,239,0.75); }
  .el-btn-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .el-btn {
    display: inline-block;
    padding: 11px 26px;
    font-family: var(--el-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #7a9bad;
    color: #7a9bad;
    background: transparent;
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }
  .el-btn:hover { background: #7a9bad; color: #fff; border-color: #7a9bad; }
  .el-btn--filled { background: #7a9bad; color: #fff; border-color: #7a9bad; }
  .el-btn--filled:hover { background: #6a8a9a; border-color: #6a8a9a; }
  .el-service-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 28px 0 0;
    font-family: var(--el-sans);
    font-size: 13px;
    color: var(--el-muted);
  }
  .el-service-area svg { width: 15px; height: 15px; flex-shrink: 0; }

  /* HOW IT WORKS */
  .el-how {
    background: var(--el-cream);
    padding: 80px 0;
  }
  .el-how-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .el-how-copy h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 44px);
    color: var(--el-ink);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .el-how-copy p {
    font-family: var(--el-sans);
    font-size: 15px;
    color: var(--el-muted);
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .el-steps { display: flex; flex-direction: column; gap: 24px; margin-top: 8px; }
  .el-step { display: flex; gap: 20px; align-items: flex-start; }
  .el-step-num {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 13px;
    color: var(--el-muted);
    min-width: 24px;
    padding-top: 3px;
    letter-spacing: 0.05em;
  }
  .el-step h3 {
    font-family: var(--font-heading-family);
    font-size: 17px;
    font-weight: 600;
    color: var(--el-ink);
    margin: 0 0 4px;
  }
  .el-step p { font-family: var(--el-sans); color: var(--el-muted); font-size: 15px; margin: 0; line-height: 1.6; }

  /* EVENTS */
  .el-events {
    background: var(--el-white);
    padding: 80px 0;
  }
  .el-events-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .el-section-label {
    margin-bottom: 48px;
  }
  .el-section-label h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    color: var(--el-ink);
    line-height: 1.2;
    margin: 0 0 10px;
  }
  .el-section-label p {
    font-family: var(--el-sans);
    font-size: 15px;
    color: var(--el-muted);
    margin: 0;
    line-height: 1.6;
  }
  .el-events-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .el-event-card {
    background: var(--el-white);
    border: 1px solid var(--el-taupe);
    padding: 28px 16px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .el-event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(27,48,84,0.08);
  }
  .el-event-icon {
    width: 26px; height: 26px;
    color: var(--el-muted);
    margin: 0 auto 14px;
    display: block;
  }
  .el-event-card h3 {
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 600;
    color: var(--el-ink);
    margin: 0;
    line-height: 1.35;
  }

  /* WHY */
  .el-why {
    background: var(--el-tan);
    padding: 80px 0;
  }
  .el-why-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .el-why-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .el-why-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .el-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    margin-top: 40px;
  }
  .el-why-item h3 {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 20px;
    color: var(--el-ink);
    margin: 0 0 10px;
  }
  .el-why-item p { font-family: var(--el-sans); font-size: 15px; color: var(--el-muted); margin: 0; line-height: 1.65; }

  /* GALLERY */
  .el-gallery {
    background: var(--el-white);
    padding: 80px 0;
  }
  .el-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .el-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  .el-gallery-item { overflow: hidden; aspect-ratio: 1 / 1; }
  .el-gallery-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* FAQ */
  .el-faq {
    background: var(--el-cream);
    padding: 80px 0;
  }
  .el-faq-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    align-items: start;
  }
  .el-faq-list { border-top: 1px solid var(--el-taupe); }
  .el-faq-item { border-bottom: 1px solid var(--el-taupe); }
  .el-faq-btn {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 20px 0;
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 600;
    color: var(--el-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .el-faq-plus {
    font-size: 20px;
    color: var(--el-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
    line-height: 1;
    font-family: var(--el-sans);
  }
  .el-faq-item.el-open .el-faq-plus { transform: rotate(45deg); }
  .el-faq-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
  .el-faq-text { padding: 0 24px 20px 0; color: var(--el-muted); font-size: 16px; font-family: var(--el-sans); line-height: 1.7; }

  /* INQUIRY */
  .el-inquiry {
    background: #2c3645;
    padding: 80px 0;
  }
  .el-inquiry-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: start;
  }
  .el-inquiry-copy h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 48px);
    color: var(--el-cream);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .el-inquiry-copy h2 em { font-style: italic; }
  .el-inquiry-copy p { font-family: var(--el-sans); font-size: 15px; color: rgba(247,244,239,0.75); margin: 0 0 12px; line-height: 1.7; }
  .el-inquiry-tagline { font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(247,244,239,0.35); margin-top: 32px; font-family: var(--el-sans); }

  /* Form card */
  .el-form-card {
    background: var(--el-cream);
    padding: 48px;
  }

  .el-field { margin-bottom: 18px; }
  .el-field label {
    display: block;
    font-family: var(--el-sans);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--el-ink);
    margin-bottom: 7px;
  }
  .el-field input:not([type="radio"]):not([type="checkbox"]),
  .el-field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--el-taupe);
    background: var(--el-white);
    font-family: var(--el-sans);
    font-size: 15px;
    color: var(--el-ink);
    transition: border-color 0.2s;
    border-radius: 0;
    appearance: none;
  }
  .el-field input::placeholder,
  .el-field textarea::placeholder { color: rgba(47,47,47,0.3); }
  .el-field input:not([type="radio"]):not([type="checkbox"]):focus,
  .el-field textarea:focus { outline: none; border-color: rgba(27,48,84,0.4); }
  .el-field textarea { resize: vertical; min-height: 100px; }
  .el-field select {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--el-taupe);
    background: var(--el-white);
    font-family: var(--el-sans);
    font-size: 15px;
    color: var(--el-ink);
    border-radius: 0;
  }
  .el-field select:focus { outline: none; border-color: rgba(27,48,84,0.4); }
  .el-radio-group { display: flex; flex-wrap: wrap; gap: 20px; padding-top: 2px; }
  .el-radio-option {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--el-sans);
    font-size: 14px;
    color: var(--el-ink);
    cursor: pointer;
  }
  .el-radio-option input { accent-color: #2c3645; width: 15px; height: 15px; cursor: pointer; }
  .el-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .el-submit-btn {
    background: #2c3645;
    color: var(--el-cream);
    border: none;
    padding: 12px 32px;
    font-family: var(--el-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-top: 4px;
  }
  .el-submit-btn:hover { opacity: 0.85; }
  .el-form-success { padding: 32px 0; }
  .el-form-success h3 { font-family: var(--font-heading-family); font-size: 28px; font-weight: 400; margin: 0 0 10px; color: var(--el-navy); }
  .el-form-success p { font-size: 15px; color: var(--el-muted); margin: 0; }

  /* Responsive */
  @media (max-width: 900px) {
    .el-how-inner, .el-faq-inner, .el-inquiry-inner, .el-why-inner { grid-template-columns: 1fr; gap: 48px; }
    .el-why-photo { display: none; }
    .el-why-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
    .el-events-grid { grid-template-columns: repeat(3, 1fr); }
    .el-form-row { grid-template-columns: 1fr; }
    .el-gallery-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .el-wrap, .el-hero, .el-how-inner, .el-events-inner, .el-why-inner, .el-faq-inner, .el-inquiry-inner, .el-gallery-inner { padding-left: 24px; padding-right: 24px; }
    .el-form-card { padding: 28px 24px; }
    .el-events-grid { grid-template-columns: 1fr 1fr; }
    .el-why-grid { grid-template-columns: 1fr; }
    .el-hero { padding: 88px 24px; }
    .el-gallery-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="el">

  <!-- HERO -->
  <div class="el-hero">
    <span class="el-eyebrow">Live Embroidery for Corporate &amp; Brand Events</span>
    <h1>The Live Embroidery Experience People Keep <em>Talking About</em></h1>
    <p class="el-lede">We bring our embroidery studio to your corporate event, retail pop-up or brand activation, stitching personalized, on-brand pieces for every guest, live and in person.</p>
    <div class="el-btn-row">
      <a href="#el-inquire" class="el-btn el-btn--filled">Request a Quote</a>
      <a href="#el-how" class="el-btn">See How It Works</a>
    </div>
    <p class="el-service-area">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-6-5.686-6-10a6 6 0 0 1 12 0c0 4.314-6 10-6 10z"/><circle cx="12" cy="11" r="2"/></svg>
      Based in the San Francisco Bay Area &middot; traveling up to 2–3 hours for events
    </p>
  </div>

  <!-- HOW IT WORKS -->
  <div id="el-how" class="el-how">
    <div class="el-how-inner">
      <div class="el-how-copy">
        <span class="el-eyebrow">The Experience</span>
        <h2>Your brand, made personal while they watch.</h2>
        <p>Guests choose a branded item, add their initials, name or an icon, pick a font and thread color, and watch it get stitched in just a few minutes. They walk away with something made for them, carrying your brand. No catalogs, no waiting weeks.</p>
        <p>It's the same hand-finished quality you'd find in our shop, just brought to life in front of an audience.</p>
      </div>
      <div>
        <div class="el-steps">
          <div class="el-step">
            <span class="el-step-num">01</span>
            <div><h3>Choose an item</h3><p>Totes, caps, sweatshirts and more, curated for your event or supplied by you.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">02</span>
            <div><h3>Pick a font style and thread color</h3><p>From our house scripts and thread library, matched to your brand colors.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">03</span>
            <div><h3>Watch it stitched</h3><p>Most pieces take just a few minutes, start to finish.</p></div>
          </div>
          <div class="el-step">
            <span class="el-step-num">04</span>
            <div><h3>Take it home</h3><p>Wrapped and ready, with their name already on it.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- EVENT TYPES -->
  <div id="el-events" class="el-events">
    <div class="el-events-inner">
      <div class="el-section-label">
        <span class="el-eyebrow">Where We Show Up</span>
        <h2>Events we're booked for</h2>
        <p>From team offsites to in-store launches, a live embroidery bar gives people a reason to stop, stay and remember your brand.</p>
      </div>
      <div class="el-events-grid">
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
          <h3>Corporate &amp; Team Events</h3>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
          <h3>Brand Activations &amp; Pop-Ups</h3>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/></svg>
          <h3>Retail &amp; In-Store Events</h3>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
          <h3>Conferences &amp; Product Launches</h3>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8"/><path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8"/></svg>
          <h3>Holiday &amp; Client Appreciation</h3>
        </div>
        <div class="el-event-card">
          <svg class="el-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
          <h3>Weddings &amp; Private Celebrations</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- WHY US -->
  <div id="el-why" class="el-why">
    <div class="el-why-inner">
      <div class="el-why-photo">
        <img src="{{ 'live-events-gallery-3.jpg' | asset_url }}" alt="The Ember Lane mobile embroidery cart set up inside a retail boutique" loading="lazy" width="800" height="1000">
      </div>
      <div>
        <div class="el-section-label">
          <span class="el-eyebrow">The Difference</span>
          <h2>Why brands book us</h2>
        </div>
        <div class="el-why-grid">
          <div class="el-why-item">
            <h3>A premium setup</h3>
            <p>Our custom-built mobile embroidery cart brings a polished, photo-ready presence to your event.</p>
          </div>
          <div class="el-why-item">
            <h3>Your brand, stitched</h3>
            <p>We match your brand colors and can digitize your logo, so every piece carries your brand.</p>
          </div>
          <div class="el-why-item">
            <h3>A moment worth posting</h3>
            <p>Guests pull out their phones before the needle even stops. Your brand ends up in their feed, and in their hands.</p>
          </div>
          <div class="el-why-item">
            <h3>Minutes, not weeks</h3>
            <p>No pre-orders, no waiting. Guests choose, watch, and walk away with it the same day.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GALLERY -->
  <div id="el-gallery" class="el-gallery">
    <div class="el-gallery-inner">
      <div class="el-section-label">
        <span class="el-eyebrow">From Recent Events</span>
        <h2>A peek behind the needle</h2>
        <p>A few moments from recent events we've brought the studio to.</p>
      </div>
      <div class="el-gallery-grid">
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-3.jpg' | asset_url }}" alt="The Ember Lane mobile embroidery cart set up inside a retail boutique" loading="lazy" width="600" height="750">
        </div>
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-1.jpg' | asset_url }}" alt="A monogrammed pair of jeans, freshly embroidered" loading="lazy" width="600" height="750">
        </div>
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-2.jpg' | asset_url }}" alt="A monogrammed sweater, freshly embroidered" loading="lazy" width="600" height="750">
        </div>
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-4.jpg' | asset_url }}" alt="Guests browsing near the embroidery station inside a retail boutique" loading="lazy" width="600" height="750">
        </div>
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-6.jpg' | asset_url }}" alt="A custom embroidery menu and freshly monogrammed items on display" loading="lazy" width="600" height="750">
        </div>
        <div class="el-gallery-item">
          <img src="{{ 'live-events-gallery-5.jpg' | asset_url }}" alt="Patio setup at an outdoor embroidery event" loading="lazy" width="600" height="750" style="object-position: top;">
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div id="el-faq" class="el-faq">
    <div class="el-faq-inner">
      <div>
        <span class="el-eyebrow">Good to Know</span>
        <h2 style="font-family:var(--font-heading-family);font-weight:400;font-size:clamp(26px,3vw,38px);color:var(--el-ink);line-height:1.2;margin:0;">Frequently asked questions</h2>
      </div>
      <div class="el-faq-list">
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">Can you stitch our logo and match our brand colors?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Yes. We digitize your logo for embroidery and match your brand colors from our thread library, so guests can add their name or initials alongside it. We can also style the station to fit your brand.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">What items can guests personalize?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Totes, caps, sweatshirts, pouches and more. We can curate and source branded items for your event, or you're welcome to provide your own merch. Tell us what you have in mind and we'll let you know what works.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How far in advance should I book?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">We recommend reaching out at least 4–6 weeks ahead, especially for spring, fall, and the holiday season. Those dates fill fastest, and logo digitizing needs a little lead time.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">Do you travel for events?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Yes. We're based in the San Francisco Bay Area and travel up to 2–3 hours for events. Travel fees may apply depending on distance, and we'll outline those clearly in your quote.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How much space and power do you need?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">A single station needs roughly a 7' × 7' footprint and access to a standard electrical outlet. Let us know your venue layout and we'll help plan around it.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How long does one piece take to stitch?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Most pieces are finished in three to eight minutes, depending on size and design complexity.</div></div>
        </div>
        <div class="el-faq-item">
          <button class="el-faq-btn" aria-expanded="false">How much does it cost?<span class="el-faq-plus" aria-hidden="true">+</span></button>
          <div class="el-faq-body"><div class="el-faq-text">Pricing depends on event length, guest count, and items selected. Share your event details below and we'll follow up with a clear, custom quote. No surprises.</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- INQUIRY -->
  <div id="el-inquire" class="el-inquiry">
    <div class="el-inquiry-inner">
      <div class="el-inquiry-copy">
        <span class="el-eyebrow" style="color:rgba(247,244,239,0.4)">Book the Experience</span>
        <h2>Let's Make<br><em>it Happen</em></h2>
        <p>Ready to bring live embroidery to your next corporate event or brand activation? Fill out the details and we'll follow up with availability and a custom quote.</p>
        <div class="el-inquiry-tagline">Ember Lane &middot; California, made by hand</div>
      </div>
      <div class="el-form-card">
        {%- form 'contact', id: 'el-inquiry-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="el-form-success">
              <h3>Thank you.</h3>
              <p>We've received your inquiry and will follow up within 1–2 business days with availability and a custom quote.</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p style="color:rgba(247,100,100,0.9);font-size:14px;margin:0 0 16px;">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="el-form-row">
              <div class="el-field">
                <label for="el-firstName">First Name</label>
                <input type="text" id="el-firstName" name="contact[first_name]" required autocomplete="given-name">
              </div>
              <div class="el-field">
                <label for="el-lastName">Last Name</label>
                <input type="text" id="el-lastName" name="contact[last_name]" required autocomplete="family-name">
              </div>
            </div>
            <div class="el-field">
              <label for="el-email">Email</label>
              <input type="email" id="el-email" name="contact[email]" required autocomplete="email">
            </div>
            <div class="el-field">
              <label for="el-phone">Phone</label>
              <input type="tel" id="el-phone" name="contact[phone]" required autocomplete="tel">
            </div>
            <div class="el-form-row">
              <div class="el-field">
                <label for="el-eventDate">Event Date</label>
                <input type="date" id="el-eventDate" name="contact[event_date]" required>
              </div>
              <div class="el-field">
                <label for="el-guestCount">Estimated # of Guests Receiving Embroidery</label>
                <input type="number" id="el-guestCount" name="contact[guest_count]" min="1" placeholder="Not sure yet? Leave blank">
              </div>
            </div>
            <div class="el-form-row">
              <div class="el-field">
                <label for="el-startTime">Event Start Time</label>
                <input type="text" id="el-startTime" name="contact[event_start_time]">
              </div>
              <div class="el-field">
                <label for="el-endTime">Event End Time</label>
                <input type="text" id="el-endTime" name="contact[event_end_time]">
              </div>
            </div>
            <div class="el-field">
              <label for="el-eventLocation">Event Location</label>
              <input type="text" id="el-eventLocation" name="contact[event_location]" required autocomplete="street-address">
            </div>
            <div class="el-field">
              <label>Venue Type</label>
              <div class="el-radio-group">
                <label class="el-radio-option"><input type="radio" name="contact[venue_type]" value="Indoor" required> Indoor</label>
                <label class="el-radio-option"><input type="radio" name="contact[venue_type]" value="Outdoor" required> Outdoor</label>
              </div>
            </div>
            <div class="el-field">
              <label>Item Variety</label>
              <div class="el-radio-group">
                <label class="el-radio-option"><input type="radio" id="el-itemVarietySame" name="contact[item_variety]" value="Identical items for every guest" required> Identical items for every guest</label>
                <label class="el-radio-option"><input type="radio" id="el-itemVarietyDifferent" name="contact[item_variety]" value="Different items per guest" required> Different items per guest</label>
              </div>
            </div>
            <div class="el-field" id="el-itemVarietyCountField" hidden>
              <label for="el-itemVarietyCount">How Many Different Kinds?</label>
              <select id="el-itemVarietyCount" name="contact[item_variety_count]">
                <option value="">Select an option</option>
                <option value="2-3 kinds">2–3 kinds</option>
                <option value="4+ kinds">4+ kinds</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            <div class="el-field">
              <label>Item Sourcing</label>
              <div class="el-radio-group">
                <label class="el-radio-option"><input type="radio" name="contact[item_sourcing]" value="We'll provide the items" required> We'll provide the items</label>
                <label class="el-radio-option"><input type="radio" name="contact[item_sourcing]" value="Need Ember Lane to source items" required> Need Ember Lane to source items</label>
              </div>
            </div>
            <div class="el-field">
              <label for="el-budget">Budget <span style="text-transform:none;letter-spacing:0;opacity:0.5;">(optional)</span></label>
              <input type="text" id="el-budget" name="contact[budget]">
            </div>
            <div class="el-field">
              <label for="el-details">Tell us about your event</label>
              <textarea id="el-details" name="contact[body]" required></textarea>
            </div>
            <button type="submit" class="el-submit-btn">Submit Inquiry</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  document.querySelectorAll('.el-faq-item').forEach(function (item) {
    var btn  = item.querySelector('.el-faq-btn');
    var body = item.querySelector('.el-faq-body');
    btn.addEventListener('click', function () {
      var isOpen = item.classList.contains('el-open');
      document.querySelectorAll('.el-faq-item.el-open').forEach(function (o) {
        o.classList.remove('el-open');
        o.querySelector('.el-faq-btn').setAttribute('aria-expanded', 'false');
        o.querySelector('.el-faq-body').style.maxHeight = null;
      });
      if (!isOpen) {
        item.classList.add('el-open');
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  var toggleVarietyCount = function () {
    var varietyDifferent = document.getElementById('el-itemVarietyDifferent');
    var varietyCountField = document.getElementById('el-itemVarietyCountField');
    var varietyCountSelect = document.getElementById('el-itemVarietyCount');
    if (!varietyDifferent || !varietyCountField) return;
    var show = varietyDifferent.checked;
    varietyCountField.hidden = !show;
    if (varietyCountSelect) { varietyCountSelect.required = show; }
  };
  document.addEventListener('change', function (e) {
    if (e.target && e.target.name === 'contact[item_variety]') { toggleVarietyCount(); }
  });
  toggleVarietyCount();

})();
</script>

