<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petit+Formal+Script&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .ell {
    --ell-navy:   #2c3645;
    --ell-ink:    #2f2f2f;
    --ell-cream:  #f7f4ef;
    --ell-mist:   #eef0f2;
    --ell-white:  #ffffff;
    --ell-line:   #e3e5e8;
    --ell-muted:  #6b6b6b;
    --ell-blue:   #7a9bad;
    --ell-script: 'Petit Formal Script', 'Brush Script MT', cursive;
    --ell-sans:   'Work Sans', 'Helvetica Neue', Arial, sans-serif;
    color: var(--ell-ink);
    letter-spacing: normal;
    -webkit-font-smoothing: antialiased;
  }
  .ell * { box-sizing: border-box; }

  .ell-eyebrow {
    display: block;
    font-family: var(--ell-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ell-muted);
    margin-bottom: 14px;
  }
  .ell-btn {
    display: inline-block;
    padding: 12px 28px;
    font-family: var(--ell-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--ell-blue);
    color: #fff;
    border: 1px solid var(--ell-blue);
    transition: background 0.2s;
    cursor: pointer;
  }
  .ell-btn:hover { background: #6a8a9a; border-color: #6a8a9a; }

  /* HERO */
  .ell-hero {
    background: var(--ell-navy);
    padding: 40px 80px 104px;
  }
  .ell-hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 72px;
    align-items: center;
  }
  .ell-mark {
    display: block;
    max-width: 1100px;
    margin: 0 auto 72px;
    font-family: var(--font-heading-family);
    font-size: 18px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(247,244,239,0.85);
  }
  .ell-mark:hover { color: var(--ell-cream); }
  .ell-hero .ell-eyebrow { color: rgba(247,244,239,0.55); }
  .ell-hero h1 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    color: var(--ell-cream);
    margin: 0 0 24px;
  }
  .ell-hero h1 em { font-style: italic; }
  .ell-hero p {
    font-family: var(--ell-sans);
    font-size: 17px;
    line-height: 1.6;
    color: rgba(247,244,239,0.92);
    max-width: 460px;
    margin: 0 0 24px;
  }
  .ell-hero-pills { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 36px; padding: 0; list-style: none; }
  .ell-hero-pills li {
    padding: 6px 14px;
    border: 1px solid rgba(247,244,239,0.3);
    border-radius: 999px;
    font-family: var(--ell-sans);
    font-size: 13px;
    color: rgba(247,244,239,0.92);
  }

  /* Phone mock */
  .ell-phone {
    width: 100%;
    max-width: 290px;
    margin: 0 auto;
    background: var(--ell-white);
    border-radius: 34px;
    padding: 14px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.35);
  }
  .ell-phone-screen {
    border-radius: 24px;
    overflow: hidden;
    background: var(--ell-cream);
    padding: 22px 18px 20px;
  }
  .ell-phone-brand {
    font-family: var(--font-heading-family);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ell-muted);
    margin-bottom: 16px;
  }
  .ell-fabric {
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0 2px, transparent 2px 5px),
      repeating-linear-gradient(-45deg, rgba(0,0,0,0.05) 0 2px, transparent 2px 5px),
      var(--fabric, #d6d9dc);
  }
  .ell-stitched {
    font-family: var(--ell-script);
    font-size: 44px;
    line-height: 1;
    color: var(--thread, #f7f4ef);
    text-shadow: 0 1px 0 rgba(0,0,0,0.25), 0 -1px 0 rgba(255,255,255,0.15);
  }
  .ell-fabric.is-canvas { box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06); }
  .ell-fabric.is-tonal { box-shadow: inset 0 0 0 1px var(--ell-line); }
  .ell-fabric.is-tonal .ell-stitched {
    text-shadow: 0 1px 1px rgba(0,0,0,0.18), 0 0 1px rgba(0,0,0,0.12);
  }
  .ell-phone-picks {
    display: flex;
    gap: 8px;
    margin: 14px 0;
    justify-content: center;
  }
  .ell-swatch {
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid var(--ell-white);
    box-shadow: 0 0 0 1px var(--ell-line);
  }
  .ell-swatch.is-on { box-shadow: 0 0 0 2px var(--ell-navy); }
  .ell-phone-btn {
    background: var(--ell-blue);
    color: #fff;
    text-align: center;
    font-family: var(--ell-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 11px;
  }

  /* MOMENTS */
  .ell-moment { padding: 96px 80px; }
  .ell-moment:nth-of-type(odd) { background: var(--ell-cream); }
  .ell-moment:nth-of-type(even) { background: var(--ell-white); }
  .ell-moment-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .ell-moment.is-flipped .ell-moment-copy { order: 2; }
  .ell-moment-title {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.2;
    color: var(--ell-ink);
    margin: 0 0 24px;
  }
  .ell-moment-title::before {
    content: "";
    display: block;
    width: 40px;
    height: 2px;
    background: var(--ell-blue);
    margin-bottom: 20px;
  }
  /* Before -> now, side by side (stacked on phones) */
  .ell-ba {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: stretch;
  }
  .ell-before, .ell-now {
    font-family: var(--ell-sans);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    padding: 20px;
  }
  .ell-before {
    color: var(--ell-muted);
    border: 1px solid var(--ell-line);
  }
  .ell-now {
    color: var(--ell-ink);
    background: #edf2f5;
    border: 1px solid var(--ell-blue);
  }
  .ell-arrow {
    align-self: center;
    font-family: var(--ell-sans);
    font-size: 20px;
    line-height: 1;
    color: var(--ell-blue);
  }
  .ell-now strong { font-weight: 500; }
  .ell-before strong { font-weight: 500; color: var(--ell-ink); }
  .ell-visual {
    display: flex;
    justify-content: center;
  }

  /* Visual: menu card */
  .ell-menu {
    width: 100%;
    max-width: 340px;
    background: var(--ell-white);
    border: 1px solid var(--ell-line);
    padding: 28px;
  }
  .ell-menu-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--ell-line);
    font-family: var(--ell-sans);
    font-size: 14px;
  }
  .ell-menu-row:last-child { border-bottom: 0; }
  .ell-menu-row span:last-child { color: var(--ell-muted); font-size: 13px; }
  .ell-menu-row.is-new span:last-child { color: var(--ell-blue); font-weight: 600; }
  .ell-menu-row.is-out { color: var(--ell-muted); text-decoration: line-through; }

  .ell-visual.has-caption { flex-direction: column; align-items: center; gap: 18px; }
  .ell-pill {
    display: inline-block;
    padding: 7px 16px;
    border: 1px solid var(--ell-line);
    border-radius: 999px;
    background: var(--ell-white);
    font-family: var(--ell-sans);
    font-size: 13px;
    color: var(--ell-muted);
    text-align: center;
  }

  /* Visual: label + machine screen */
  .ell-stack { position: relative; width: 100%; max-width: 360px; height: 260px; }
  .ell-screen {
    position: absolute;
    top: 0; left: 0;
    width: 78%;
    background: #1f2630;
    color: #dfe6ec;
    border-radius: 8px;
    padding: 18px;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
    box-shadow: 0 18px 40px rgba(0,0,0,0.18);
  }
  .ell-screen div { padding: 7px 10px; border-radius: 3px; opacity: 0.55; }
  .ell-screen div.is-top { background: var(--ell-blue); color: #fff; opacity: 1; }
  .ell-label {
    position: absolute;
    right: 0; bottom: 0;
    width: 62%;
    aspect-ratio: 2.25 / 1.25;
    background: var(--ell-white);
    border: 1px solid var(--ell-line);
    padding: 12px 14px;
    box-shadow: 0 14px 30px rgba(0,0,0,0.12);
    transform: rotate(-3deg);
    font-family: var(--ell-sans);
  }
  .ell-label b { display: block; font-size: 26px; line-height: 1; margin-bottom: 6px; }
  .ell-label span { display: block; font-size: 12px; color: var(--ell-muted); line-height: 1.45; }

  /* Visual: hoop + on-machine card */
  .ell-hoop-wrap { position: relative; width: 100%; max-width: 360px; height: 270px; }
  .ell-card {
    position: absolute;
    top: 0; left: 0;
    width: 64%;
    background: var(--ell-white);
    border: 1px solid var(--ell-line);
    border-left: 3px solid var(--ell-blue);
    padding: 16px 18px;
    font-family: var(--ell-sans);
    box-shadow: 0 14px 30px rgba(0,0,0,0.08);
  }
  .ell-card small { display: block; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ell-blue); margin-bottom: 6px; }
  .ell-card b { display: block; font-size: 18px; margin-bottom: 2px; }
  .ell-card span { font-size: 13px; color: var(--ell-muted); }
  .ell-hoop {
    position: absolute;
    right: 0; bottom: 0;
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 10px solid #d3d7db;
    box-shadow: inset 0 0 0 3px #bcc2c8, 0 16px 34px rgba(0,0,0,0.14);
    background:
      repeating-linear-gradient(45deg, rgba(0,0,0,0.02) 0 2px, transparent 2px 5px),
      #fbfbfb;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ell-hoop .ell-label {
    position: static;
    width: 120px;
    padding: 8px 10px;
    transform: rotate(4deg);
  }
  .ell-hoop .ell-label b { font-size: 18px; margin-bottom: 3px; }
  .ell-hoop .ell-label span { font-size: 10px; }

  /* Visual: clock */
  .ell-clock {
    width: 100%;
    max-width: 360px;
    background: var(--ell-white);
    border: 1px solid var(--ell-line);
    padding: 28px;
    font-family: var(--ell-sans);
  }
  .ell-clock-row { display: flex; justify-content: space-between; font-size: 13px; color: var(--ell-muted); margin-bottom: 8px; }
  .ell-bar { height: 10px; background: var(--ell-mist); border-radius: 5px; overflow: hidden; margin-bottom: 22px; }
  .ell-bar i { display: block; height: 100%; background: var(--ell-blue); border-radius: 5px; }
  .ell-bar.is-line i { background: var(--ell-navy); }
  .ell-clock-btn {
    margin-top: 6px;
    border: 1px solid var(--ell-navy);
    text-align: center;
    padding: 11px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ell-navy);
  }

  /* STORY */
  .ell-story { background: var(--ell-cream); padding: 104px 80px; }
  .ell-story-inner, .ell-what-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .ell-story h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.15;
    color: var(--ell-ink);
    margin: 0;
  }
  .ell-story p {
    font-family: var(--font-heading-family);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.45;
    color: var(--ell-ink);
    margin: 0 0 20px;
  }
  .ell-story .ell-sign {
    font-family: var(--ell-script);
    font-size: 22px;
    line-height: 1.3;
    color: var(--ell-ink);
    margin: 36px 0 0;
  }
  .ell-story .ell-sign small {
    display: block;
    margin-top: 6px;
    font-family: var(--ell-sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ell-muted);
  }

  /* WHAT IT IS */
  .ell-what { background: var(--ell-white); padding: 96px 80px; }
  .ell-what h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.15;
    color: var(--ell-ink);
    margin: 0;
  }
  .ell-what p {
    font-family: var(--ell-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--ell-muted);
    margin: 0;
  }
  .ell-what p.ell-what-summary { font-style: italic; font-size: 14px; color: rgba(107,107,107,0.75); }
  .ell-compat { margin: 32px 0 0; padding-top: 24px; border-top: 1px solid var(--ell-line); }
  .ell-compat dl { margin: 0; font-family: var(--ell-sans); font-size: 15px; line-height: 1.6; }
  .ell-compat dt { color: var(--ell-ink); font-weight: 500; }
  .ell-compat dd { margin: 0 0 12px; color: var(--ell-muted); }
  .ell-compat dd:last-child { margin-bottom: 0; }

  /* CLOSE */
  .ell-close {
    background: var(--ell-cream);
    padding: 104px 80px;
    text-align: center;
  }
  .ell-close h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(32px, 4.2vw, 52px);
    line-height: 1.12;
    color: var(--ell-ink);
    margin: 0 auto;
    max-width: 760px;
  }
  .ell-close h2 em { font-style: italic; }

  /* FORM */
  .ell-access { background: var(--ell-navy); padding: 96px 80px; }
  .ell-access-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: start;
  }
  .ell-access-copy .ell-eyebrow { color: rgba(247,244,239,0.45); }
  .ell-access-copy h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.12;
    color: var(--ell-cream);
    margin: 0 0 20px;
  }
  .ell-access-copy p {
    font-family: var(--ell-sans);
    font-size: 17px;
    line-height: 1.65;
    color: rgba(247,244,239,0.9);
    margin: 0;
  }
  .ell-form-card { background: var(--ell-cream); padding: 44px; }
  .ell-field { margin-bottom: 18px; }
  .ell-field label {
    display: block;
    font-family: var(--ell-sans);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ell-ink);
    margin-bottom: 7px;
  }
  .ell-field label small { text-transform: none; letter-spacing: 0; opacity: 0.55; font-size: 12px; }
  .ell-field input,
  .ell-field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--ell-line);
    background: var(--ell-white);
    font-family: var(--ell-sans);
    font-size: 15px;
    color: var(--ell-ink);
    border-radius: 0;
    appearance: none;
  }
  .ell-field input:focus,
  .ell-field textarea:focus { outline: none; border-color: rgba(44,54,69,0.45); }
  .ell-field textarea { resize: vertical; min-height: 96px; }
  .ell-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: end; }
  .ell-form-success h3 { font-family: var(--font-heading-family); font-size: 28px; font-weight: 400; margin: 0 0 10px; color: var(--ell-navy); }
  .ell-form-success p { font-family: var(--ell-sans); font-size: 15px; color: var(--ell-muted); margin: 0; }

  @media (max-width: 900px) {
    .ell-hero-inner, .ell-moment-inner, .ell-access-inner { grid-template-columns: 1fr; gap: 48px; }
    .ell-story-inner, .ell-what-inner { grid-template-columns: 1fr; gap: 24px; }
    .ell-moment.is-flipped .ell-moment-copy { order: 0; }
    .ell-form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ell-hero { padding: 24px 24px 56px; }
    .ell-mark { margin-bottom: 40px; font-size: 14px; }
    .ell-eyebrow { font-size: 10px; margin-bottom: 12px; }
    .ell-hero h1 { font-size: 32px; margin-bottom: 16px; }
    .ell-hero p { font-size: 15px; margin-bottom: 20px; }
    .ell-hero-pills { margin-bottom: 28px; }
    .ell-hero-pills li { font-size: 12px; }
    .ell-moment-title { font-size: 26px; margin-bottom: 20px; }
    .ell-moment-title::before { margin-bottom: 16px; }
    .ell-btn { font-size: 11px; padding: 11px 22px; }
    .ell-phone { max-width: 230px; }
    .ell-stitched { font-size: 36px; }
    .ell-hero-inner, .ell-moment-inner, .ell-access-inner { gap: 36px; }
    .ell-moment, .ell-story, .ell-what, .ell-close, .ell-access { padding: 56px 24px; }
    .ell-ba { grid-template-columns: 1fr; gap: 8px; }
    .ell-arrow { justify-self: center; transform: rotate(90deg); }
    .ell-before, .ell-now { padding: 18px; }
    .ell-menu, .ell-clock { max-width: 300px; padding: 20px; }
    .ell-menu-row { font-size: 13px; padding: 10px 0; }
    .ell-menu-row span:last-child { font-size: 12px; }
    .ell-pill { font-size: 12px; }
    .ell-stack, .ell-hoop-wrap { max-width: 300px; }
    .ell-hoop { width: 170px; height: 170px; }
    .ell-story h2, .ell-what h2 { font-size: 26px; }
    .ell-story p { font-size: 18px; }
    .ell-story .ell-sign { font-size: 20px; margin-top: 28px; }
    .ell-what p { font-size: 15px; }
    .ell-close h2 { font-size: 28px; }
    .ell-access-copy h2 { font-size: 28px; }
    .ell-access-copy p { font-size: 15px; }
    .ell-form-card { padding: 24px 20px; }
    .ell-field label { font-size: 11px; }
    /* 16px keeps iOS Safari from zooming into the field */
    .ell-field input, .ell-field textarea { font-size: 16px; }
  }
</style>

<div class="ell">

  <!-- HERO -->
  <div class="ell-hero">
    <a href="{{ routes.root_url }}" class="ell-mark">Ember Lane</a>
    <div class="ell-hero-inner">
      <div>
        <span class="ell-eyebrow">Ember Lane Live &middot; Live embroidery software</span>
        <h1>Less managing orders. <em>More embroidery.</em></h1>
        <p>Software built for live embroidery activations. Let guests customize and preview their designs, automate order intake, and coordinate your production queue from one system.</p>
        <ul class="ell-hero-pills">
          <li>Guest self-service</li>
          <li>Automated design files</li>
          <li>Live queue management</li>
        </ul>
        <a href="#ell-access" class="ell-btn">Request early access</a>
      </div>
      <div class="ell-phone" aria-hidden="true">
        <div class="ell-phone-screen">
          <div class="ell-phone-brand">Ember Lane</div>
          <div class="ell-fabric is-canvas" style="--fabric:#ebe7df;--thread:#2c3645;">
            <span class="ell-stitched">Olivia</span>
          </div>
          <div class="ell-phone-picks">
            <span class="ell-swatch is-on" style="background:#2c3645"></span>
            <span class="ell-swatch" style="background:#f7f4ef"></span>
            <span class="ell-swatch" style="background:#7a9bad"></span>
            <span class="ell-swatch" style="background:#781e23"></span>
          </div>
          <div class="ell-phone-btn">Place order</div>
        </div>
      </div>
    </div>
  </div>

  <!-- THE WEEK BEFORE -->
  <div class="ell-moment">
    <div class="ell-moment-inner">
      <div class="ell-moment-copy">
        <h2 class="ell-moment-title">Prepare for events without rebuilding everything from scratch</h2>
        <div class="ell-ba">
          <p class="ell-before"><strong>The week before.</strong> You build the embroidery order form in Canva and print it. You spend an hour stitching out the menu. Then the host changes a color, and you start again.</p>
          <span class="ell-arrow" aria-hidden="true">&rarr;</span>
          <p class="ell-now">Now the order form lives on the guest's phone, with a live preview of every design. <strong>Change it the night before, or halfway through the event.</strong> The next guest sees it.</p>
        </div>
      </div>
      <div class="ell-visual" aria-hidden="true">
        <div class="ell-menu">
          <span class="ell-eyebrow">Embroidery Menu</span>
          <div class="ell-menu-row"><span>Canvas tote</span><span>White &middot; Navy</span></div>
          <div class="ell-menu-row"><span>Script name</span><span>3 thread colors</span></div>
          <div class="ell-menu-row is-out"><span>Blush thread</span><span>Sold out</span></div>
          <div class="ell-menu-row is-new"><span>Sage thread</span><span>Just added</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- AT THE COUNTER -->
  <div class="ell-moment is-flipped">
    <div class="ell-moment-inner">
      <div class="ell-moment-copy">
        <h2 class="ell-moment-title">Let guests choose confidently without constant consultation</h2>
        <div class="ell-ba">
          <p class="ell-before"><strong>At the counter.</strong> &ldquo;Will white show up on off-white?&rdquo; You hold a spool against the shirt and hope they can picture it.</p>
          <span class="ell-arrow" aria-hidden="true">&rarr;</span>
          <p class="ell-now">Now they see it. <strong>Their name, their thread, on their item,</strong> before they order.</p>
        </div>
      </div>
      <div class="ell-visual has-caption">
        <div class="ell-menu" style="padding:18px;" aria-hidden="true">
          <div class="ell-fabric is-tonal" style="--fabric:#efede8;--thread:#ffffff;">
            <span class="ell-stitched">Katelyn</span>
          </div>
        </div>
        <span class="ell-pill">Your own fonts, thread colors and blanks</span>
      </div>
    </div>
  </div>

  <!-- AT THE MACHINE -->
  <div class="ell-moment">
    <div class="ell-moment-inner">
      <div class="ell-moment-copy">
        <h2 class="ell-moment-title">Stop manually adjusting every letter</h2>
        <div class="ell-ba">
          <p class="ell-before"><strong>At the machine.</strong> Find the font. Type the name. Nudge every letter until the joins touch. USB stick. Find the file. Center it again. Three guests are waiting.</p>
          <span class="ell-arrow" aria-hidden="true">&rarr;</span>
          <p class="ell-now">Now you <strong>hoop and press start.</strong> The name is already on the machine, lined up, at the top of the list.</p>
        </div>
      </div>
      <div class="ell-visual" aria-hidden="true">
        <div class="ell-stack">
          <div class="ell-screen">
            <div class="is-top">0022_KJ.pes</div>
            <div>0021_OM.pes</div>
            <div>0020_AR.pes</div>
          </div>
          <div class="ell-label">
            <b>#22</b>
            <span>Katelyn</span>
            <span>Sweatshirt &middot; Off-white &middot; White</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BETWEEN ORDERS -->
  <div class="ell-moment is-flipped">
    <div class="ell-moment-inner">
      <div class="ell-moment-copy">
        <h2 class="ell-moment-title">Never lose track of whose order is whose</h2>
        <div class="ell-ba">
          <p class="ell-before"><strong>Between orders.</strong> The needle stops, and everyone scrambles. Whose is this? Which shirt? Where's the next one?</p>
          <span class="ell-arrow" aria-hidden="true">&rarr;</span>
          <p class="ell-now">Now the label prints the moment they order. <strong>The next blank is hooped and tagged before the needle stops.</strong></p>
        </div>
      </div>
      <div class="ell-visual" aria-hidden="true">
        <div class="ell-hoop-wrap">
          <div class="ell-card">
            <small>On machine</small>
            <b>#22 Katelyn</b>
            <span>Sweatshirt &middot; White</span>
          </div>
          <div class="ell-hoop">
            <div class="ell-label">
              <b>#23</b>
              <span>Amara</span>
              <span>Tote &middot; Navy</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- THE LAST HOUR -->
  <div class="ell-moment">
    <div class="ell-moment-inner">
      <div class="ell-moment-copy">
        <h2 class="ell-moment-title">Know when you&rsquo;re approaching event capacity</h2>
        <div class="ell-ba">
          <p class="ell-before"><strong>The last hour.</strong> Twenty orders still in line, and the venue wants you out. You turn people away, or you stitch at home until midnight.</p>
          <span class="ell-arrow" aria-hidden="true">&rarr;</span>
          <p class="ell-now">Now you see it coming. <strong>The line and the clock, side by side.</strong> Stop taking orders while everyone in line still gets theirs.</p>
        </div>
      </div>
      <div class="ell-visual" aria-hidden="true">
        <div class="ell-clock">
          <div class="ell-clock-row"><span>Time left</span><span>0:48</span></div>
          <div class="ell-bar"><i style="width:40%"></i></div>
          <div class="ell-clock-row"><span>Line to stitch</span><span>0:45</span></div>
          <div class="ell-bar is-line"><i style="width:37%"></i></div>
          <div class="ell-clock-btn">Pause ordering</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STORY -->
  <div class="ell-story">
    <div class="ell-story-inner">
      <div>
        <span class="ell-eyebrow">Our story</span>
        <h2>Why we built this</h2>
      </div>
      <div>
        <p>We got tired of spending hours nudging letters into place in Embrilliance, and of paper order forms going missing at retail pop-ups. So we built the system we wished we'd had at the cart.</p>
        <p>We run our own events on it now.</p>
        <p class="ell-sign">Amy &amp; David<small>Ember Lane</small></p>
      </div>
    </div>
  </div>

  <!-- WHAT IT IS -->
  <div class="ell-what">
    <div class="ell-what-inner">
      <div>
        <span class="ell-eyebrow">Live embroidery software</span>
        <h2>What is Ember Lane Live?</h2>
      </div>
      <div>
        <p class="ell-what-summary">Ember Lane Live is a live embroidery management system for studios that stitch at events. Guests order from their phones through your own ordering portal. Your crew runs the line from one live queue, with a label printed for every order and each name sent to the machine ready to stitch. You keep the craft. It keeps the line moving.</p>
        <div class="ell-compat">
          <span class="ell-eyebrow">Works with today</span>
          <dl>
            <dt>Machines</dt>
            <dd>Brother and Baby Lock embroidery machines that use .pes files</dd>
            <dt>Computer</dt>
            <dd>A Windows laptop at the event (guests order from any phone)</dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- CLOSE -->
  <div class="ell-close">
    <h2>You came to stitch. <em>Not to stress.</em></h2>
  </div>

  <!-- EARLY ACCESS -->
  <div id="ell-access" class="ell-access">
    <div class="ell-access-inner">
      <div class="ell-access-copy">
        <span class="ell-eyebrow">Early access</span>
        <h2>Run your next event on Ember Lane Live.</h2>
        <p>We built it for our own live events. Now we're opening it to a few studios who do the same. Tell us how you work and we'll be in touch.</p>
      </div>
      <div class="ell-form-card">
        {%- form 'contact', id: 'ell-access-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="ell-form-success">
              <h3>Thank you.</h3>
              <p>We'll be in touch about early access.</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p style="color:#a33;font-size:14px;margin:0 0 16px;">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <input type="hidden" name="contact[inquiry]" value="Ember Lane Live early access">
            <div class="ell-form-row">
              <div class="ell-field">
                <label for="ell-name">Name</label>
                <input type="text" id="ell-name" name="contact[name]" required autocomplete="name">
              </div>
              <div class="ell-field">
                <label for="ell-email">Email</label>
                <input type="email" id="ell-email" name="contact[email]" required autocomplete="email">
              </div>
            </div>
            <div class="ell-form-row">
              <div class="ell-field">
                <label for="ell-company">Your company</label>
                <input type="text" id="ell-company" name="contact[company]" required autocomplete="organization">
              </div>
              <div class="ell-field">
                <label for="ell-link">Website or social</label>
                <input type="text" id="ell-link" name="contact[website_or_social]" required>
              </div>
            </div>
            <div class="ell-form-row">
              <div class="ell-field">
                <label for="ell-machine">Which machine do you bring to events?</label>
                <input type="text" id="ell-machine" name="contact[machine]" required placeholder="e.g. Baby Lock Venture 2">
              </div>
              <div class="ell-field">
                <label for="ell-machine-count">How many machines?</label>
                <input type="number" id="ell-machine-count" name="contact[machine_count]" required min="1" inputmode="numeric">
              </div>
            </div>
            <div class="ell-field">
              <label for="ell-body">How do you take orders at events today? <small>(optional)</small></label>
              <textarea id="ell-body" name="contact[body]"></textarea>
            </div>
            <button type="submit" class="ell-btn">Request early access</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

</div>

