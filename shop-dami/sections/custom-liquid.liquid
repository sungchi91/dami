<style>                                                                                                                                                        
    .ig-section {                                                                                                                                                
      background-color: #FFFFFF;                                                                                                                                 
      padding: 6rem 0;                                                                                                                                           
    }
    .ig-section .ig-inner {                                                                                                                                      
      max-width: 80rem;
      margin: 0 auto;                                                                                                                                            
      padding: 0 1.5rem;
    }                                                                                                                                                            
    .ig-section .ig-header {
      text-align: center;
      margin-bottom: 4rem;
    }
    .ig-section .ig-handle {
      display: block;
      font-size: 1rem;
      letter-spacing: 0.15em;                                                                                                                                    
      text-transform: uppercase;
      color: #1B3054;                                                                                                                                            
      margin-bottom: .5;                                                                                                                                       
    }           
    @media (min-width: 768px) {
      .ig-section .ig-heading { font-size: 3rem; }                                                                                                            
    }
    .ig-section .ig-grid {                                                                                                                                       
      display: grid;                                                                                                                                             
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;                                                                                                                                                 
    }             
    @media (min-width: 768px) {
      .ig-section .ig-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    }                                                                                                                                                            
    .ig-section .ig-item {
      position: relative;                                                                                                                                        
      aspect-ratio: 1;
      overflow: hidden;                                                                                                                                          
      cursor: pointer;
    }
    .ig-section .ig-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;                                                                                                                                         
      transition: transform 0.5s ease;
      display: block;                                                                                                                                            
    }             
    .ig-section .ig-item:hover img { transform: scale(1.05); }
    .ig-section .ig-overlay {                                                                                                                                    
      position: absolute;
      inset: 0;                                                                                                                                                  
      background: rgba(27, 48, 84, 0);
      transition: background 0.3s ease;                                                                                                                          
    }
    .ig-section .ig-item:hover .ig-overlay { background: rgba(27, 48, 84, 0.2); }                                                                                
    .ig-section .ig-item--tilt-left  { transform: rotate(-1deg); }                                                                                               
    .ig-section .ig-item--tilt-right { transform: rotate(1deg); }                                                                                                
    .ig-section .ig-cta {                                                                                                                                        
      text-align: center;                                                                                                                                        
      margin-top: 3rem;
    }                                                                                                                                                            
    .ig-section .ig-cta a {
      color: #1B3054;                                                                                                                                            
      font-size: 1.2rem;
      text-decoration: underline;                                                                                                                                
      text-underline-offset: 3px;
    }
    .ig-section .ig-cta a:hover { opacity: 0.7; }                                                                                                                
  </style>
                                                                                                                                                                 
  {%- assign gallery_fallback = 'Image_May_1_2026_07_21_44_PM.png' | file_url -%}
  {%- assign gallery_images = 'https://cdn.shopify.com/s/files/1/0990/0326/9486/files/Screen_Shot_2026-05-10_at_8.05.33_PM.png?v=1778468772,https://cdn.shopify.com/s/files/1/0990/0326/9486/files/IMG_5407.jpg?v=1778468772,https://cdn.shopify.com/s/files/1/0990/0326/9486/files/IMG_5294.jpg?v=1778468771,https://cdn.shopify.com/s/files/1/0990/0326/9486/files/IMG_5599.jpg?v=1779073529,https://cdn.shopify.com/s/files/1/0990/0326/9486/files/IMG_1456.jpg,https://cdn.shopify.com/s/files/1/0990/0326/9486/files/IMG_5628.jpg?v=1779073529' | split: ',' -%}
  {%- assign gallery_count = '0,1,2,3,4,5' | split: ',' -%}

  <section class="ig-section">
    <div class="ig-inner">

      <div class="ig-header">
        <span class="ig-handle">@shopemberlane</span>
        <h2 class="ig-heading">In the Wild</h2>
      </div>

      <div class="ig-grid" id="ig-grid">
        {%- for idx in gallery_count -%}
          {%- assign tilt = '' -%}
          {%- if forloop.index0 == 2 -%}{%- assign tilt = 'ig-item--tilt-left' -%}{%- endif -%}
          {%- if forloop.index0 == 4 -%}{%- assign tilt = 'ig-item--tilt-right' -%}{%- endif -%}
          {%- assign img_src = gallery_images[forloop.index0] | default: gallery_fallback -%}

          <div class="ig-item {{ tilt }}">
            <a href="https://instagram.com/shopemberlane" target="_blank" rel="noopener noreferrer">
              <img
                width="600"
                height="600"
                src="{{ img_src }}"
                alt="Emberlane in the wild"
                loading="lazy"
              />
            </a>
            <div class="ig-overlay"></div>
          </div>
        {%- endfor -%}
      </div>

      <script>
        (function () {
          var FEED_URL = 'https://feeds.behold.so/KvY6kx1QD9TBJf0KYeec';
          var TILTS   = ['', '', 'ig-item--tilt-left', '', 'ig-item--tilt-right', ''];

          fetch(FEED_URL)
            .then(function (r) { return r.json(); })
            .then(function (data) {
              var items = Array.isArray(data) ? data : (data.posts || data.data || []);
              if (!items.length) return;
              var posts = items.slice(0, 6).map(function (item) {
                var img = item.mediaType === 'VIDEO'
                  ? item.thumbnailUrl
                  : (item.sizes && item.sizes.medium && item.sizes.medium.mediaUrl) || item.mediaUrl || '';
                return { url: img, link: item.permalink };
              }).filter(function (p) { return p.url; });
              if (!posts.length) return;
              var grid = document.getElementById('ig-grid');
              if (!grid) return;
              grid.innerHTML = posts.map(function (post, i) {
                return '<div class="ig-item ' + (TILTS[i] || '') + '">' +
                  '<a href="' + post.link + '" target="_blank" rel="noopener noreferrer">' +
                  '<img src="' + post.url + '" alt="Emberlane in the wild" loading="lazy" width="600" height="600">' +
                  '</a>' +
                  '<div class="ig-overlay"></div>' +
                  '</div>';
              }).join('');
            })
            .catch(function () { /* keep hardcoded fallback on any error */ });
        })();
      </script>
                                                                                                                                                                 
      <div class="ig-cta">
        <a href="https://instagram.com/shopemberlane" target="_blank" rel="noopener noreferrer">                                                                     
          Follow along on Instagram                                                                                                                              
        </a>
      </div>                                                                                                                                                     
                  
    </div>
  </section>